        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld bağlantı içe aktarıldı"
          }
        }
      }
    },
    "%lld connections use it. They keep its user name, but their password has to be entered again.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu profili %lld bağlantı kullanıyor. Bağlantılar kullanıcı adını korur, ancak şifrelerinin yeniden girilmesi gerekir."
          }
        }
      }
    },
    "192.168.1.10 or server.example.com": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "192.168.1.10 veya sunucu.ornek.com"
          }
        }
      }
    },
    "A profile keeps one user name and password, such as a domain account, for several connections. Change the password here once and every connection uses the new one.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil, örneğin bir domain hesabı gibi tek bir kullanıcı adı ve şifreyi birden fazla bağlantı için saklar. Şifreyi burada bir kez değiştirin, tüm bağlantılar yenisini kullanır."
          }
        }
      }
    },
