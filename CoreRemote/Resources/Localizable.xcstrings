    "%lld added, %lld skipped (already present), %lld new groups.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld eklendi, %lld atlandı (zaten mevcut), %lld yeni grup."
          }
        }
      }
    },
    "%lld connections": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld connection"
