              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld connections"
                }
              }
            }
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld bağlantı"
          }
        }
      }
    },
    "%lld connections and all groups will be saved to a .coreremote file.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld connection and all groups will be saved to a .coreremote file."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld connections and all groups will be saved to a .coreremote file."
                }
              }
            }
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld bağlantı ve tüm gruplar bir .coreremote dosyasına kaydedilecek."
          }
        }
      }
    },
    "%lld connections imported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld connection imported"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
